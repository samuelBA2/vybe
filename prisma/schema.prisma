// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String?    @unique
  phone      String?    @unique
  hashedPassword String?
  firstname  String?
  lastname   String?
  avatarUrl  String?
  avatarPublicId String?
  role       Role
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events Event[]
  participations EventParticipant[]
  agentAccess Agent[]

  orders Order[]
  notifications Notification[]
  ledgerEntries LedgerEntry[]

  otpVerications OtpVerification[]

  profileUpdatedAt  DateTime?  // date de la dernière modification
  profileUpdateCount Int       @default(0)  // nb de modifs ce mois-ci
  profileUpdateMonth Int       @default(0)  // mois du compteur (1-12)
  profileUpdateYear  Int       @default(0)  // année du compteur

  // Soft delete : false pendant le délai de grâce (2 semaines) avant purge définitive.
  // Un compte invalide ne peut plus se connecter mais reste récupérable.
  isValid            Boolean   @default(true)
  deletionRequestedAt DateTime? // date de la demande de suppression (point de départ des 2 semaines)

  // Verrou progressif de connexion par mot de passe.
  // failedLoginAttempts : compteur de la série en cours (0..5), remis à 0 à chaque verrou et à chaque succès.
  // loginLockLevel : palier atteint (0 aucun, 1 → 5min, 2 → 1h, 3+ → 12h), ne redescend que sur connexion réussie.
  // loginLockedUntil : fin du verrou en cours ; null = pas de verrou actif.
  failedLoginAttempts Int       @default(0)
  loginLockLevel      Int       @default(0)
  loginLockedUntil    DateTime?
}

model UsedToken {
  jti       String   @id
  createdAt DateTime @default(now())
}

enum NotificationType {
  EVENT_SUBMITTED
  EVENT_PUBLISHED
  EVENT_REJECTED
}

// Notification in-app d'un utilisateur. Texte rendu (title/body en français) stocké
// directement ; le `type` sert au frontend pour choisir l'icône/dégradé. eventId permet
// le lien « Voir l'événement ». read = suivi lu/non-lu (badge cloche + mise en évidence).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  eventId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])       // compteur des non-lues
  @@index([userId, createdAt])  // liste chronologique
}

model EventParticipant {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])


  UserId    String
  user      User     @relation(fields: [UserId], references: [id])

  @@unique([eventId, UserId]) // Un utilisateur ne peut rejoindre un événement qu'une seule fois
}

enum Role {
  USER   // tout inscrit : self-service (créer événements/agents, encaisser)
  AGENT  // agent de sécurité : scan des QR codes uniquement
}

model OtpVerification {
  id        String   @id @default(uuid())
  identifier String   // email ou téléphone
  code       String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  // Défini après MAX tentatives échouées, bloque pendant 20 min
  blockedUntil DateTime?
  createdAt DateTime @default(now())
  //Null pour l'inscription, renseigné pour la reconnexion
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  // Index sur le champ de filtre principal des requêtes OTP (verify, block,
  // cooldown, persist). Composite [identifier, used] : sert aussi les requêtes
  // filtrant uniquement sur identifier (préfixe gauche). Évite le full table scan
  // sur une table qui grossit à chaque tentative de connexion/inscription.
  @@index([identifier, used])
}

// Événement
model Event {
  id            String   @id @default(uuid())
  // Numéro public lisible de l'événement, ex. "VYBE-67XC6F".
  // Sert de poignée humaine (affichage, désignation de l'événement
  // à la création d'un agent). L'isolation technique reste sur l'id.
  reference     String   @unique
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  location      String
  gpsLat        Float?
  gpsLng        Float?
  purchaseDeadline DateTime
  dressCode     String?
  category      EventCategory
  status        EventStatus  @default(DRAFT)
  termsAccepted Boolean      @default(false)
  createdAt     DateTime     @default(now())
  reviewedAt    DateTime?    // date de la décision de modération (validation/refus)
  totalCapacity Int?         // null = billetterie illimitée ; sinon capacité totale (max 50000)

  participants EventParticipant[] 

  ticketCategories TicketCategory[]
  mediaFiles       EventMedia[]
  agents           Agent[]

  // Keyset GET /events : WHERE status=PUBLISHED ORDER BY startDate.
  @@index([status, startDate])
  // Keyset GET /events/mine : WHERE createdById=... ORDER BY createdAt.
  @@index([createdById, createdAt])
}

model EventMedia {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String?    // secure_url Cloudinary
  publicId  String?    // public_id Cloudinary (pour delete/transform)
  fileName  String
  mimeType  String
  sizeBytes Int
  mediaType MediaType
  isPoster  Boolean   @default(false) // true pour l'affiche (exactement 1 par événement)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
  @@index([eventId, isPoster])
}

model UploadedAsset {
  id        String        @id @default(uuid())
  publicId  String        @unique          // = fileKey renvoyé au client
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  mediaType MediaType
  ownerId   String                          // req.user.sub
  attached  Boolean       @default(false)   // true quand rattaché à un Event
  createdAt DateTime      @default(now())

  @@index([attached, createdAt]) // pour le balayage de purge
  @@index([ownerId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  DESIGN   // AI, PSD, EPS, TIFF...
  OTHER
}

enum EventCategory {
  CONCERT
  FESTIVAL
  CONFERENCE
  SPORT
  CULTURAL
  THEATRE
  OTHER
}

enum EventStatus {
  DRAFT  //event encours de creation 
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CLOSED
  CANCELLED
}


// Catégorie de billet
model TicketCategory {
  id           String  @id @default(uuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id])
  name         String  // Standard, VIP, VVIP...
  price        Float
  totalStock   Int?    // null = stock illimité
  ticketDesignUrl String // URL de l'image de design du billet
  soldCount    Int     @default(0) //
  giftedCount  Int     @default(0) // compteur des billets offerts émis (≤ 10) ; alimente le compteur X/10 de la carte et le bloc gifts du dashboard
  maxPerOrder  Int     @default(10) // Max billets par commande
  benefits     String?
  
  tickets      Ticket[]
  orders       Order[]
}

// Commande (1 commande = N billets)
model Order {
  id               String      @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  quantity         Int
  unitPrice        Float
  // totalAmount/platformFee/organizerAmount restent en USD = base comptable.
  totalAmount      Float
  platformFee      Float
  organizerAmount  Float
  // Devise réellement débitée à l'acheteur (USD ou CDF au taux figé USD_TO_CDF_RATE).
  currency         Currency  @default(USD)
  // Part de CETTE commande dans le montant réellement débité (dans `currency`) ;
  // @default(0) pour les commandes existantes lors de la migration. Σ chargedAmount d'un
  // paymentRef = montant total poussé au fournisseur.
  chargedAmount    Float     @default(0)
  // Id de transaction côté fournisseur (trace/réconciliation) ; posé après initPayment.
  providerTxnId    String?
  paymentStatus    PaymentStatus @default(PENDING)
  // Référence de transaction PARTAGÉE par les N commandes d'un même checkout.
  // Format/longueur à finaliser au choix du fournisseur (certains limitent à 20 car.).
  paymentRef       String?
  createdAt        DateTime    @default(now())

  tickets          Ticket[]

  // Filtre réel du dashboard : paymentStatus='PAID' AND ticketCategoryId IN (...).
  // Le composite couvre aussi les lookups par ticketCategoryId seul (préfixe).
  @@index([ticketCategoryId, paymentStatus])
  // Webhook/reaper/status résolvent toutes les commandes d'un checkout par paymentRef.
  @@index([paymentRef])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED   // paiement refusé par le fournisseur
  EXPIRED  // PENDING abandonné / timeout (reaper) : stock relâché, peut être re-honoré si payé tard
  REVIEW   // accepté mais non résolvable automatiquement : résolution manuelle (règle : un paiement accepté ne reste jamais sans résolution)
  REFUNDED // (Lot 2)
  GIFT     // billet offert par le créateur : montants 0, exclu du calcul financier (≠ PAID)
}

// Devise d'un Order / d'une écriture de ledger. USD = base comptable ; CDF = franc congolais
// (affichage + certains débits Mobile Money), converti au taux figé USD_TO_CDF_RATE.
enum Currency {
  USD
  CDF
}

// Type de compte comptable virtuel d'une écriture de ledger.
enum LedgerAccount {
  ORGANIZER // dette de Vybe envers l'organisateur (IOU) = solde retirable (Lot 2)
  PLATFORM  // revenu de Vybe (commission 15 %)
}

// Nature de l'écriture (le signe du montant confirme crédit/débit).
enum LedgerEntryType {
  SALE_ORGANIZER   // crédit organisateur au PAID (+)
  SALE_PLATFORM    // crédit plateforme au PAID (+)
  REFUND_ORGANIZER // (Lot 2) débit organisateur sur remboursement (-)
  PAYOUT_ORGANIZER // (Lot 2) débit organisateur sur retrait Mobile Money (-)
}

// Écriture de ledger = SOURCE DE VÉRITÉ des soldes. Écrite dans la MÊME transaction que la
// génération des billets au passage PAID. Le solde organisateur = SUM(amount) WHERE
// userId=X AND account=ORGANIZER. L'argent réel (100 %) est chez le fournisseur sur le
// compte marchand Vybe ; le split 85/15 est VIRTUEL (comptable), le ledger ne détient pas d'argent.
model LedgerEntry {
  id        String          @id @default(uuid())
  account   LedgerAccount
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  type      LedgerEntryType
  amount    Float           // SIGNÉ : crédits > 0, débits (payout/refund) < 0
  currency  Currency        @default(USD) // ledger en USD = base comptable
  orderId   String?
  eventId   String?
  createdAt DateTime        @default(now())

  @@index([userId, account])   // solde par compte
  @@index([userId, createdAt]) // historique keyset
  @@index([orderId])           // réconciliation par commande
}

// Journal d'audit générique des échanges avec le fournisseur (séparé du ledger).
// Sert la réconciliation par paymentRef / providerTxnId. Aucune donnée sensible
// (numéro Mobile Money) n'y est persistée volontairement.
model PaymentProviderLog {
  id           String   @id @default(uuid())
  paymentRef   String
  direction    String   // 'INIT' | 'CHECK' | 'WEBHOOK' | 'AUTH'
  requestBody  Json?
  responseBody Json?
  status       String?
  createdAt    DateTime @default(now())

  @@index([paymentRef])
}

// Billet individuel (1 billet = 1 QR code)
model Ticket {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  qrToken          String    @unique // UUID v4 cryptographique
  qrStatus         QRStatus  @default(UNUSED)
  scannedAt        DateTime?
  scannedByAgentId String?
  cancelledAt      DateTime?  // posé au passage en CANCELLED (brique d'annulation future) ; lu par GET /me/tickets pour la règle des 24h
  giftDownloadedAt DateTime? // billets offerts : horodaté au 1er téléchargement → disparition définitive de l'onglet offerts

  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([qrToken])   // Index pour les lookups rapides de scan
  @@index([expiresAt]) // Index pour le nettoyage automatique
  // Dashboard : agrégats/timeline par catégorie + statut, tri par scannedAt.
  @@index([ticketCategoryId, qrStatus, scannedAt])
}

enum QRStatus {
  UNUSED
  USED
  CANCELLED
}

// Agent de sécurité
model Agent {
  id          String    @id @default(uuid())
  firstname   String
  lastname    String
  hashCode    String    @unique // identifie l'agent avec un SHA-256 du code "AG-XXXXXXXX"  
  active      Boolean   @default(true)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])

  userId      String?   
  user        User?     @relation(fields: [userId], references: [id])
}
