// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String?    @unique
  phone      String?    @unique
  googleId   String?    @unique
  hashedPassword String?
  firstname  String?
  lastname   String?
  avatarUrl  String?
  avatarPublicId String?
  role       Role
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events Event[]
  participations EventParticipant[]
  agentAccess Agent[]
  reservations Reservation[]

  orders Order[]
  notifications Notification[]
  ledgerEntries LedgerEntry[]
  payoutClaims PayoutClaim[]

  otpVerications OtpVerification[]

  profileUpdatedAt  DateTime?  // date de la dernière modification
  profileUpdateCount Int       @default(0)  // nb de modifs ce mois-ci
  profileUpdateMonth Int       @default(0)  // mois du compteur (1-12)
  profileUpdateYear  Int       @default(0)  // année du compteur

  // Soft delete : false pendant le délai de grâce (2 semaines) avant purge définitive.
  // Un compte invalide ne peut plus se connecter mais reste récupérable.
  isValid            Boolean   @default(true)
  deletionRequestedAt DateTime? // date de la demande de suppression (point de départ des 2 semaines)

  // Verrou progressif de connexion par mot de passe.
  // failedLoginAttempts : compteur de la série en cours (0..5), remis à 0 à chaque verrou et à chaque succès.
  // loginLockLevel : palier atteint (0 aucun, 1 → 5min, 2 → 1h, 3+ → 12h), ne redescend que sur connexion réussie.
  // loginLockedUntil : fin du verrou en cours ; null = pas de verrou actif.
  failedLoginAttempts Int       @default(0)
  loginLockLevel      Int       @default(0)
  loginLockedUntil    DateTime?
}

model UsedToken {
  jti       String   @id
  createdAt DateTime @default(now())
}

enum NotificationType {
  EVENT_SUBMITTED
  EVENT_PUBLISHED
  EVENT_REJECTED
}

// Notification in-app d'un utilisateur. Texte rendu (title/body en français) stocké
// directement ; le `type` sert au frontend pour choisir l'icône/dégradé. eventId permet
// le lien « Voir l'événement ». read = suivi lu/non-lu (badge cloche + mise en évidence).
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  eventId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])       // compteur des non-lues
  @@index([userId, createdAt])  // liste chronologique
}

model EventParticipant {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])


  UserId    String
  user      User     @relation(fields: [UserId], references: [id])

  @@unique([eventId, UserId]) // Un utilisateur ne peut rejoindre un événement qu'une seule fois
}

enum Role {
  USER   // tout inscrit : self-service (créer événements/agents, encaisser)
  AGENT  // agent de sécurité : scan des QR codes uniquement
}

model OtpVerification {
  id        String   @id @default(uuid())
  identifier String   // email ou téléphone
  code       String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  // Défini après MAX tentatives échouées, bloque pendant 20 min
  blockedUntil DateTime?
  createdAt DateTime @default(now())
  //Null pour l'inscription, renseigné pour la reconnexion
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  // Index sur le champ de filtre principal des requêtes OTP (verify, block,
  // cooldown, persist). Composite [identifier, used] : sert aussi les requêtes
  // filtrant uniquement sur identifier (préfixe gauche). Évite le full table scan
  // sur une table qui grossit à chaque tentative de connexion/inscription.
  @@index([identifier, used])
}

// Événement
model Event {
  id            String   @id @default(uuid())
  // Numéro public lisible de l'événement, ex. "VYBE-67XC6F".
  // Sert de poignée humaine (affichage, désignation de l'événement
  // à la création d'un agent). L'isolation technique reste sur l'id.
  reference     String   @unique
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  location      String
  gpsLat        Float?
  gpsLng        Float?
  purchaseDeadline DateTime
  dressCode     String?
  category      EventCategory
  priceCurrency Currency     @default(USD) // devise de tarification (choix créateur). @default = backfill DB uniquement ; le DTO l'exige à la création.
  status        EventStatus  @default(DRAFT)
  termsAccepted Boolean      @default(false)
  createdAt     DateTime     @default(now())
  reviewedAt    DateTime?    // date de la décision de modération (validation/refus)
  totalCapacity Int?         // null = billetterie illimitée ; sinon capacité totale (max 50000)

  participants EventParticipant[] 

  ticketCategories TicketCategory[]
  mediaFiles       EventMedia[]
  agents           Agent[]
  reservations     Reservation[]

  // Keyset GET /events : WHERE status=PUBLISHED ORDER BY startDate.
  @@index([status, startDate])
  // Keyset GET /events/mine : WHERE createdById=... ORDER BY createdAt.
  @@index([createdById, createdAt])
}

model EventMedia {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String?    // secure_url Cloudinary
  publicId  String?    // public_id Cloudinary (pour delete/transform)
  fileName  String
  mimeType  String
  sizeBytes Int
  mediaType MediaType
  isPoster  Boolean   @default(false) // true pour l'affiche (exactement 1 par événement)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([eventId])
  @@index([eventId, isPoster])
}

model UploadedAsset {
  id        String        @id @default(uuid())
  publicId  String        @unique          // = fileKey renvoyé au client
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  mediaType MediaType
  ownerId   String                          // req.user.sub
  attached  Boolean       @default(false)   // true quand rattaché à un Event
  createdAt DateTime      @default(now())

  @@index([attached, createdAt]) // pour le balayage de purge
  @@index([ownerId])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  DESIGN   // AI, PSD, EPS, TIFF...
  OTHER
}

enum EventCategory {
  CONCERT
  FESTIVAL
  CONFERENCE
  SPORT
  CULTURAL
  THEATRE
  OTHER
}

enum EventStatus {
  DRAFT  //event encours de creation 
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CLOSED
  CANCELLED
}


// Catégorie de billet
model TicketCategory {
  id           String  @id @default(uuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id])
  name         String  // Standard, VIP, VVIP...
  price        Float
  totalStock   Int?    // null = stock illimité
  ticketDesignUrl String // URL de l'image de design du billet
  soldCount    Int     @default(0) //
  giftedCount  Int     @default(0) // compteur des billets offerts émis (≤ 10) ; alimente le compteur X/10 de la carte et le bloc gifts du dashboard

  // --- réservation (cash à la porte) ---
  reservationEnabled Boolean @default(false) // true = catégorie d'entrée ouverte à la réservation (une seule par événement)
  reservationCap     Int     @default(50)    // plafond de réservations actives
  reservedCount      Int     @default(0)     // réservations qui "tiennent" : +1 réserve, -1 supprime, INCHANGÉ à l'encaissement
  maxPerOrder  Int     @default(10) // Max billets par commande
  benefits     String?
  
  tickets      Ticket[]
  reservations Reservation[]
  orders       Order[]
}

// Commande (1 commande = N billets)
model Order {
  id               String      @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  quantity         Int
  unitPrice        Float
  // totalAmount/platformFee/organizerAmount restent en USD = base comptable.
  totalAmount      Float
  platformFee      Float
  organizerAmount  Float
  // Devise réellement débitée à l'acheteur (USD ou CDF au taux figé USD_TO_CDF_RATE).
  currency         Currency  @default(USD)
  // Part de CETTE commande dans le montant réellement débité (dans `currency`) ;
  // @default(0) pour les commandes existantes lors de la migration. Σ chargedAmount d'un
  // paymentRef = montant total poussé au fournisseur.
  chargedAmount    Float     @default(0)
  // Id de transaction côté fournisseur (trace/réconciliation) ; posé après initPayment.
  providerTxnId    String?
  paymentStatus    PaymentStatus @default(PENDING)
  // Référence de transaction PARTAGÉE par les N commandes d'un même checkout.
  // Format/longueur à finaliser au choix du fournisseur (certains limitent à 20 car.).
  paymentRef       String?
  createdAt        DateTime    @default(now())

  tickets          Ticket[]

  // Filtre réel du dashboard : paymentStatus='PAID' AND ticketCategoryId IN (...).
  // Le composite couvre aussi les lookups par ticketCategoryId seul (préfixe).
  @@index([ticketCategoryId, paymentStatus])
  // Webhook/reaper/status résolvent toutes les commandes d'un checkout par paymentRef.
  @@index([paymentRef])
}

// Idempotence de POST /order (I1) : une clé client (en-tête Idempotency-Key) =
// un seul checkout. Rejouer la même clé renvoie le même paymentRef, sans nouvelle
// réservation de stock ni nouveau push. ARAKA ne déduplique pas les références :
// cette garantie est entièrement côté Vybe. Purgé après 24 h par le reaper.
model CheckoutRequest {
  id          String   @id @default(uuid())
  userId      String
  key         String
  // sha256 du panier trié + opérateur + numéro : une clé réutilisée pour un autre
  // panier est refusée (422).
  fingerprint String
  paymentRef  String
  createdAt   DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt]) // purge
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED   // paiement refusé par le fournisseur
  EXPIRED  // PENDING abandonné / timeout (reaper) : stock relâché, peut être re-honoré si payé tard
  REVIEW   // accepté mais non résolvable automatiquement : résolution manuelle (règle : un paiement accepté ne reste jamais sans résolution)
  REFUNDED // (Lot 2)
  GIFT     // billet offert par le créateur : montants 0, exclu du calcul financier (≠ PAID)
}

// Devise d'un Order / d'une écriture de ledger. USD = base comptable ; CDF = franc congolais
// (affichage + certains débits Mobile Money), converti au taux figé USD_TO_CDF_RATE.
enum Currency {
  USD
  CDF
}

// Type de compte comptable virtuel d'une écriture de ledger.
enum LedgerAccount {
  ORGANIZER // dette de Vybe envers l'organisateur (IOU)
  PLATFORM  // revenu de Vybe (commission 20 %)
}

// Nature de l'écriture (le signe du montant confirme crédit/débit).
enum LedgerEntryType {
  SALE_ORGANIZER   // crédit organisateur au PAID (+)
  SALE_PLATFORM    // crédit plateforme au PAID (+)
  REFUND_ORGANIZER // débit organisateur sur remboursement (-)
  PAYOUT_ORGANIZER // retrait organisateur : négatif = déduction à la demande, positif = restauration au rejet
}

// Écriture de ledger = SOURCE DE VÉRITÉ des soldes. Écrite dans la MÊME transaction que la
// génération des billets au passage PAID. Le solde organisateur = SUM(amount) WHERE
// userId=X AND account=ORGANIZER. L'argent réel (100 %) est chez le fournisseur sur le
// compte marchand Vybe ; le split 80/20 est VIRTUEL (comptable), le ledger ne détient pas d'argent.
model LedgerEntry {
  id        String          @id @default(uuid())
  account   LedgerAccount
  userId    String 
  user      User            @relation(fields: [userId], references: [id]) 
  type      LedgerEntryType
  amount    Float           // SIGNÉ : crédits > 0, débits (refund) < 0
  currency  Currency        @default(USD) // multi-devises : écrit dans la devise de la commande
  orderId   String?
  eventId   String?
  createdAt DateTime        @default(now())

  @@index([userId, account])   // solde par compte
  @@index([userId, createdAt]) // historique keyset
  @@index([orderId])           // réconciliation par commande
}

// Journal d'audit générique des échanges avec le fournisseur (séparé du ledger).
// Sert la réconciliation par paymentRef / providerTxnId. Aucune donnée sensible
// (numéro Mobile Money) n'y est persistée volontairement.
model PaymentProviderLog {
  id           String   @id @default(uuid())
  paymentRef   String
  direction    String   // 'INIT' | 'CHECK' | 'WEBHOOK' | 'AUTH'
  requestBody  Json?
  responseBody Json?
  status       String?
  createdAt    DateTime @default(now())

  @@index([paymentRef])
}

// Billet individuel (1 billet = 1 QR code)
model Ticket {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  qrToken          String    @unique // UUID v4 cryptographique
  qrStatus         QRStatus  @default(UNUSED)
  scannedAt        DateTime?
  scannedByAgentId String?
  cancelledAt      DateTime?  // posé au passage en CANCELLED (brique d'annulation future) ; lu par GET /me/tickets pour la règle des 24h
  giftDownloadedAt DateTime? // billets offerts : horodaté au 1er téléchargement → disparition définitive de l'onglet offerts

  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  @@index([qrToken])   // Index pour les lookups rapides de scan
  @@index([expiresAt]) // Index pour le nettoyage automatique
  // Dashboard : agrégats/timeline par catégorie + statut, tri par scannedAt.
  @@index([ticketCategoryId, qrStatus, scannedAt])
}

enum QRStatus {
  UNUSED
  USED
  CANCELLED
}

// Agent de sécurité
model Agent {
  id          String    @id @default(uuid())
  firstname   String
  lastname    String
  hashCode    String    @unique // identifie l'agent avec un SHA-256 du code "AG-XXXXXXXX"
  codeEnc     String?   // code "AG-XXXXXXXX" chiffré (AES-256-GCM) pour le réafficher à l'organisateur (null = agents créés avant cette feature)
  active      Boolean   @default(true)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  eventId     String
  event       Event     @relation(fields: [eventId], references: [id])

  userId      String?   
  user        User?     @relation(fields: [userId], references: [id])
}

// Statut d'une réclamation de retrait net (« Réclamer le net »).
enum PayoutClaimStatus {
  SENT       // demande envoyée, solde déjà déduit, en attente de l'équipe Vybe
  CONFIRMED  // l'équipe Vybe a confirmé l'envoi de l'argent (aucun effet ledger)
  CANCELLED  // l'équipe Vybe a rejeté → solde restauré par écriture inverse
}

// Réclamation de retrait MANUEL assisté. Persiste la demande (le solde est déduit
// dès la création) pour suivre son statut et permettre la confirmation par magic-link.
model PayoutClaim {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  currency   Currency
  amount     Float             // montant figé au moment de la demande (= solde déduit)
  mmoNumber  String            // numéro Mobile Money de réception
  status     PayoutClaimStatus @default(SENT)
  jti        String            @unique // id du token magic-link (intégrité du lien)
  createdAt  DateTime          @default(now())
  lastSentAt DateTime          @default(now()) // dernier envoi du mail (cooldown « Renvoyer »)
  decidedAt  DateTime?         // posé au CONFIRMED / CANCELLED

  @@index([userId, currency, status]) // « réclamation active » par devise
  @@index([userId, createdAt])        // reprise / historique
}

enum ReservationStatus {
  RESERVED   // réservé, non payé (QR → pop-up jaune au scan)
  USED       // encaissé cash + admis à la porte (usage unique)
  CANCELLED  // supprimé par l'agent
}

enum ReservationResolution {
  PENDING    // en attente de passage à la porte
  COLLECTED  // encaissé cash à la porte
  DELETED    // supprimé par l'agent
}

// Réservation (cash à la porte). Entité de 1re classe : NI Order NI Ticket. Porte son propre
// qrToken scanné à la porte, et vit tout son cycle de vie dans cette seule ligne (seul le statut change).
model Reservation {
  id                String                @id @default(uuid())
  eventId           String
  event             Event                 @relation(fields: [eventId], references: [id])
  categoryId        String
  category          TicketCategory        @relation(fields: [categoryId], references: [id])
  userId            String                // compte qui réserve
  user              User                  @relation(fields: [userId], references: [id])

  qrToken           String                @unique // token opaque, scanné à la porte
  status            ReservationStatus     @default(RESERVED)
  resolution        ReservationResolution @default(PENDING)

  // Contact saisi dans le pop-up — stocké ICI, JAMAIS sur User (le porteur peut différer
  // du titulaire du compte → permet de faire la différence).
  holderFirstName   String
  holderLastName    String
  holderPhone       String

  paidAtGate        Boolean               @default(false)
  resolvedByAgentId String?               // agent ayant encaissé/supprimé (réconciliation)
  reservedAt        DateTime              @default(now())
  resolvedAt        DateTime?
  expiresAt         DateTime              // = event.endDate
  createdAt         DateTime              @default(now())

  gateCashCollection GateCashCollection?

  @@index([eventId])
  @@index([userId])
  @@index([eventId, status])
  @@index([categoryId])
}

// Cash encaissé à la porte. SÉPARÉ du LedgerEntry (dette de Vybe envers l'organisateur) :
// ce cash ne transite jamais par Vybe → n'affecte ni soldes ni retraits. Source du compteur
// dashboard "Total encaissement billets réservés".
model GateCashCollection {
  id            String      @id @default(uuid())
  eventId       String
  reservationId String      @unique // 1 encaissement par réservation (idempotence)
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  amount        Float               // = prix de la catégorie à l'instant de l'encaissement
  currency      Currency
  agentId       String              // agent encaisseur (attribution)
  createdAt     DateTime    @default(now())

  @@index([eventId])
}
