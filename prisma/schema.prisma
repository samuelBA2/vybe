// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String?    @unique
  phone      String?    @unique
  hashedPassword String?
  firstname  String?
  lastname   String?
  avatarUrl  String?
  role       Role
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  events Event[]
  participations EventParticipant[]
  agentAccess Agent[]

  orders Order[]
  
  otpVerications OtpVerification[]

  profileUpdatedAt  DateTime?  // date de la dernière modification
  profileUpdateCount Int       @default(0)  // nb de modifs ce mois-ci
  profileUpdateMonth Int       @default(0)  // mois du compteur (1-12)
  profileUpdateYear  Int       @default(0)  // année du compteur

  // Soft delete : false pendant le délai de grâce (2 semaines) avant purge définitive.
  // Un compte invalide ne peut plus se connecter mais reste récupérable.
  isValid            Boolean   @default(true)
  deletionRequestedAt DateTime? // date de la demande de suppression (point de départ des 2 semaines)
}

model UsedToken {
  jti       String   @id
  createdAt DateTime @default(now())
}

model EventParticipant {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())

  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])


  UserId    String
  user      User     @relation(fields: [UserId], references: [id])

  @@unique([eventId, UserId]) // Un utilisateur ne peut rejoindre un événement qu'une seule fois
}

enum Role {
  ADMIN
  AGENT
}

model OtpVerification {
  id        String   @id @default(uuid())
  identifier String   // email ou téléphone
  code       String
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  expiresAt DateTime
  // Défini après MAX tentatives échouées, bloque pendant 20 min
  blockedUntil DateTime?
  createdAt DateTime @default(now())

  //Null pour l'inscription, renseigné pour la reconnexion
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

// Événement
model Event {
  id            String   @id @default(uuid())
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  location      String
  gpsLat        Float?
  gpsLng        Float?
  purchaseDeadline DateTime
  dressCode     String?
  category      EventCategory
  status        EventStatus  @default(DRAFT)
  termsAccepted Boolean      @default(false)
  createdAt     DateTime     @default(now())

  participants EventParticipant[] 

  ticketCategories TicketCategory[]
  mediaFiles       EventMedia[]
  agents           Agent[]
}

model EventMedia {
  id        String    @id @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url       String
  fileKey   String    // clé S3/R2
  fileName  String
  mimeType  String
  sizeBytes Int
  mediaType MediaType
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  DESIGN   // AI, PSD, EPS, TIFF...
  OTHER
}

enum EventCategory {
  CONCERT
  FESTIVAL
  CONFERENCE
  SPORT
  CULTURAL
  THEATRE
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}


// Catégorie de billet
model TicketCategory {
  id           String  @id @default(uuid())
  eventId      String
  event        Event   @relation(fields: [eventId], references: [id])
  name         String  // Standard, VIP, VVIP...
  price        Float
  totalStock   Int     // Capacité max
  soldCount    Int     @default(0)
  maxPerOrder  Int     @default(10) // Max billets par commande
  benefits     String?
  
  tickets      Ticket[]
  orders       Order[]
}

// Commande (1 commande = N billets)
model Order {
  id               String      @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  quantity         Int
  unitPrice        Float
  totalAmount      Float
  platformFee      Float
  organizerAmount  Float
  paymentStatus    PaymentStatus @default(PENDING)
  paymentRef       String?
  createdAt        DateTime    @default(now())

  tickets          Ticket[]
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Billet individuel (1 billet = 1 QR code)
model Ticket {
  id               String    @id @default(uuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  ticketCategoryId String
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  qrToken          String    @unique // UUID v4 cryptographique
  qrStatus         QRStatus  @default(UNUSED)
  scannedAt        DateTime?
  scannedByAgentId String?

  expiresAt         DateTime
  pdfUrl           String?
  createdAt        DateTime  @default(now())

  @@index([qrToken])   // Index pour les lookups rapides de scan
  @@index([expiresAt]) // Index pour le nettoyage automatique
}

enum QRStatus {
  UNUSED
  USED
  CANCELLED
}

// Agent de sécurité
model Agent {
  id          String    @id @default(uuid())
  firstname   String
  lastname    String
  code        String    @unique //"AG-LJXW1"
  active      Boolean   @default(true)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])

  userId      String?   
  user        User?    @relation(fields: [userId], references: [id])
}
